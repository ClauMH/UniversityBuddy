@{
    ViewBag.Title = "Horario";
}

<h2>Horario</h2>

<h3 id="current-time">00:00:00</h3>

<hr />

<h4>Temporizador</h4>

<input type="number" id="minutes" min="1" placeholder="Minutos" />

<button id="btnStart">Iniciar</button>
<button id="btnStop">Detener</button>

<h3 id="countdown">00:00</h3>

<hr />

<h4>Alarma</h4>

<input type="time" id="alarmTime" />

<input type="text"
       id="alarmName"
       placeholder="Nombre de la alarma" />

<button id="btnAddAlarm">
    Agregar alarma
</button>

<ul id="alarmList"></ul>
<script src="/Scripts/horario.js"></script>