@using System.Linq
@model IEnumerable<UniversityBuddy.Models.Materias>
@{
    ViewBag.Title = "Materias";
    var formMateria = ViewBag.MateriaActual as UniversityBuddy.Models.Materias ?? new UniversityBuddy.Models.Materias();
    bool esEdicion = formMateria.ID_Materia > 0;
}

<style>
    h2.materias-titulo {
        color: #ffffff !important;
    }

    .card.materias-card {
        background-color: #ffffff !important;
        color: #111827 !important;
    }

        .card.materias-card label,
        .card.materias-card .form-label {
            color: #111827 !important;
            font-weight: 600 !important;
            opacity: 1 !important;
        }

        .card.materias-card input.form-control {
            color: #111827 !important;
            background-color: #ffffff !important;
        }
</style>

<div class="container mt-4">
    <h2>Gestión de Materias</h2>

    <div class="card materias-card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <strong>@(esEdicion ? "Editar Materia" : "Nueva Materia")</strong>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("GuardarMateria", "Home", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="ID_Materia" value="@formMateria.ID_Materia" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Nombre de la Materia *</label>
                        <input type="text" name="Nombre" class="form-control" value="@formMateria.Nombre" maxlength="100" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Maestro / Docente</label>
                        <input type="text" name="Maestro" class="form-control" value="@formMateria.Maestro" maxlength="100" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Contacto</label>
                        <input type="text" name="Contacto" class="form-control" value="@formMateria.Contacto" maxlength="100" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Aula</label>
                        <input type="text" name="Aula" class="form-control" value="@formMateria.Aula" maxlength="100" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Horario</label>
                        <input type="time" name="Horario" class="form-control"
                               value="@(formMateria.Horario.HasValue ? formMateria.Horario.Value.ToString(@"hh\:mm") : "")" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Imagen (ruta o URL)</label>
                        <input type="text" name="ImagenMateria" class="form-control" value="@formMateria.ImagenMateria" maxlength="100" />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success">
                        @(esEdicion ? "Actualizar Cambios" : "Guardar Materia")
                    </button>
                    @if (esEdicion)
                    {
                        <a href="@Url.Action("Materias", "Home")" class="btn btn-secondary ms-2">Cancelar</a>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card materias-card shadow-sm">
        <div class="card-header bg-dark text-white">
            <strong>Materias Inscritas</strong>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Imagen</th>
                        <th>Materia</th>
                        <th>Maestro</th>
                        <th>Contacto</th>
                        <th>Aula</th>
                        <th>Horario</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ImagenMateria))
                                    {
                                        <img src="@Url.Content(item.ImagenMateria)" alt="@item.Nombre" style="width: 40px; height: 40px; object-fit: cover; border-radius: 6px;" />
                                    }
                                </td>
                                <td class="fw-bold">@item.Nombre</td>
                                <td>@item.Maestro</td>
                                <td>@item.Contacto</td>
                                <td>@item.Aula</td>
                                <td>@(item.Horario.HasValue ? item.Horario.Value.ToString(@"hh\:mm") : "")</td>
                                <td class="text-center">
                                    <a href="@Url.Action("Materias", "Home", new { idEditar = item.ID_Materia })" class="btn btn-sm btn-outline-primary me-1">Editar</a>

                                    @using (Html.BeginForm("EliminarMateria", "Home", new { id = item.ID_Materia }, FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar esta materia?');">Eliminar</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Aún no has agregado ninguna materia.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
