@model IEnumerable<UniversityBuddy.Models.Actividad>

@{
    ViewBag.Title = "Mis Asignaciones";
    string estadoActual = ViewBag.EstadoActual ?? "Todas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 style="font-family:'Gabriola', serif; font-size:2.5rem;">Mis Asignaciones</h2>
    @Html.ActionLink("➕ Nueva Asignación", "Create", null, new { @class = "btn btn-success" })
</div>

<!-- Filtros de Estado -->
<div class="btn-group mb-4" role="group">
    @Html.ActionLink("Todas", "Index", new { estadoFiltro = "Todas" }, new { @class = "btn " + (estadoActual == "Todas" ? "btn-primary" : "btn-outline-primary") })
    @Html.ActionLink("⏳ En proceso", "Index", new { estadoFiltro = "En proceso" }, new { @class = "btn " + (estadoActual == "En proceso" ? "btn-warning text-dark" : "btn-outline-warning") })
    @Html.ActionLink("⚠️ Atrasadas", "Index", new { estadoFiltro = "Atrasada" }, new { @class = "btn " + (estadoActual == "Atrasada" ? "btn-danger" : "btn-outline-danger") })
    @Html.ActionLink("✅ Completadas", "Index", new { estadoFiltro = "Completada" }, new { @class = "btn " + (estadoActual == "Completada" ? "btn-success" : "btn-outline-success") })
</div>

<!-- Tabla de Asignaciones -->
<div class="table-responsive card p-3 shadow-sm" style="background: var(--hover); border: 1px solid var(--border);">
    <table class="table align-middle">
        <thead>
            <tr>
                <th style="width:50px;">Listo</th>
                <th>Asignación</th>
                <th>Materia</th>
                <th>Categoría</th>
                <th>Fecha Entrega</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                bool isDone = item.Estado == "Completada";
                <tr id="row-@item.ID_Actividad" class="@(isDone ? "opacity-75" : "")">
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input chk-completar"
                               data-id="@item.ID_Actividad" @(isDone ? "checked" : "") style="transform: scale(1.3); cursor:pointer;" />
                    </td>
                    <td>
                        <strong class="@(isDone ? "text-decoration-line-through" : "")">@item.Nombre</strong>
                        @if (!string.IsNullOrEmpty(item.Descripcion))
                        {
                            <br /><small class="text-muted">@item.Descripcion</small>
                        }
                    </td>
                    <td><span class="badge bg-secondary">@item.Materia.Nombre</span></td>
                    <td>@item.Categoria</td>
                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>
                        <span id="badge-@item.ID_Actividad" class="badge @(item.Estado == "Completada" ? "bg-success" : item.Estado == "Atrasada" ? "bg-danger" : "bg-warning text-dark")">
                            @item.Estado
                        </span>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">No tienes asignaciones registradas en este filtro.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Flotante de Felicitación -->
<div class="modal fade" id="modalFelicitacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4" style="background: var(--bg-2); border: 2px solid #818cf8; border-radius: 16px;">
            <div style="font-size: 4rem;">🎉🥳</div>
            <h3 style="font-family:'Gabriola', serif; font-size:2.4rem; color:#818cf8;" class="mt-2">¡Felicidades!</h3>
            <p class="fs-5 mt-2">Has completado tu asignación con éxito.<br /><strong>¡Te has ganado un merecido tiempo de descanso! ☕📚</strong></p>
            <div class="mt-3">
                <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal">¡Entendido, a descansar!</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.chk-completar').change(function () {
                var chk = $(this);
                var id = chk.data('id');
                var isChecked = chk.is(':checked');

                $.ajax({
                    url: '@Url.Action("CambiarEstado", "Asignaciones")',
                    type: 'POST',
                    data: { id: id, completada: isChecked },
                    success: function (res) {
                        if (res.success) {
                            var badge = $('#badge-' + id);
                            badge.text(res.nuevoEstado);

                            if (res.nuevoEstado === 'Completada') {
                                badge.attr('class', 'badge bg-success');
                                $('#row-' + id).addClass('opacity-75');

                                // Mostrar Modal de Felicitación
                                var myModal = new bootstrap.Modal(document.getElementById('modalFelicitacion'));
                                myModal.show();
                            } else if (res.nuevoEstado === 'Atrasada') {
                                badge.attr('class', 'badge bg-danger');
                                $('#row-' + id).removeClass('opacity-75');
                            } else {
                                badge.attr('class', 'badge bg-warning text-dark');
                                $('#row-' + id).removeClass('opacity-75');
                            }
                        }
                    }
                });
            });
        });
    </script>
}