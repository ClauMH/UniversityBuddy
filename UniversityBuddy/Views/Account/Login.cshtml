@model UniversityBuddy.Models.LoginViewModel

@{
    // 1. Quita la plantilla global de _Layout.cshtml
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - University Buddy</title>

    <!-- Carga inicial del tema para evitar parpadeos -->
    <script>
        (function () {
            var theme = localStorage.getItem('ub_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>

    <!-- Carga de estilos de Bootstrap y personalización -->
    @Styles.Render("~/Content/css")
    <link href="~/Content/sidebar.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card p-4 shadow-lg" style="background: var(--hover); border: 1px solid var(--border); border-radius: 20px;">
                    <div class="text-center mb-3">
                        <span style="font-size: 3.5rem;">🎓</span>
                        <h1 style="font-family:'Gabriola', serif; font-size: 2.8rem; margin-bottom:0;" class="text-primary">University Buddy</h1>
                        <p class="text-muted small">Ingresa tus credenciales para continuar</p>
                    </div>

                    @if (TempData["MensajeExito"] != null)
                    {
                        <div class="alert alert-success small mb-3">
                            @TempData["MensajeExito"]
                        </div>
                    }

                    @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-2" })

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.NomUsuario, new { @class = "form-label font-weight-bold" })
                            @Html.TextBoxFor(m => m.NomUsuario, new { @class = "form-control", placeholder = "Usuario", maxlength = "10" })
                            @Html.ValidationMessageFor(m => m.NomUsuario, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Contrasena, new { @class = "form-label font-weight-bold" })
                            @Html.PasswordFor(m => m.Contrasena, new { @class = "form-control", placeholder = "••••••••" })
                            @Html.ValidationMessageFor(m => m.Contrasena, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-check mb-3">
                            @Html.CheckBoxFor(m => m.Recordarme, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.Recordarme, new { @class = "form-check-label" })
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 font-weight-bold">
                            🔑 Iniciar Sesión
                        </button>
                    }

                    <hr style="border-color: var(--border);" />

                    <div class="text-center">
                        <span class="small text-muted">¿No tienes una cuenta aún?</span><br />
                        @Html.ActionLink("Crear una cuenta", "Registro", "Account", null, new { @class = "btn btn-outline-secondary btn-sm mt-2 w-100" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>